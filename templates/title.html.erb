<!DOCTYPE html>
<html>
<head>
  <meta
    charset="UTF-8"
  >
  <style><%= styles %></style>
</head>
<body>
  <div
    class="slide title"
  >
    <h1><%= slide[:title] %></h1>
    <% if slide[:subtitle] %>
      <div
        class="subtitle"
      ><%= slide[:subtitle] %></div>
    <% end %>
    <%= brand_mark %>
    <div
      class="slide-number"
    ><%= slide_number %></div>
  </div>
</body>
</html>
